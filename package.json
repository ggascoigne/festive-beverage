{
  "name": "festive-beverage",
  "version": "0.1.0",
  "private": true,
  "description": "FestiveBeverage site",
  "license": "MIT",
  "author": "guy@wyrdrune.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/ggascoigne/festive-beverage.git"
  },
  "files": [],
  "type": "module",
  "scripts": {
    "boot": "pnpm db:migrate:up && pnpm prisma:generate && pnpm gitHash",
    "build": "pnpm writeCert && pnpm boot && NODE_ENV=production next build",
    "db:clean": "pnpm db:start && ./scripts/createCleanDb.ts",
    "db:import": "pnpm db:start && ./scripts/toLocal.ts",
    "db:migrate:generate": "knex migrate:make --knexfile ./support/knexfile.js",
    "db:migrate:up": "node --env-file-if-exists=.env --import tsx node_modules/knex/bin/cli.js migrate:latest --knexfile ./support/knexfile.ts up",
    "db:resetOwner": "./scripts/resetDatabaseOwner.ts",
    "db:setup": "pnpm db:clean && pnpm db:migrate:up",
    "db:start": "docker compose up -d && ./scripts/wait-for-postgres.sh -c festive-beverage-postgres",
    "dev": "pnpm boot && next dev -p 40000 --turbo",
    "dev:debug": "pnpm boot && NODE_OPTIONS='--inspect' next dev -p 40000",
    "import": "pnpm db:clean && pnpm db:migrate:up && ./scripts/import.ts",
    "importPush": "pnpm run import && pnpm upload",
    "download": "./scripts/toLocal.ts",
    "upload": "./scripts/toAws.ts",
    "format": "oxfmt",
    "gitHash": "./scripts/getGitHash.sh",
    "lint": "oxlint --fix",
    "preinstall": "npx only-allow pnpm",
    "prisma:generate": "node --env-file-if-exists=.env ./node_modules/prisma/build/index.js generate --no-hints --sql",
    "postinstall": "node ./scripts/postinstall-prisma.mjs",
    "disabled:postinstall": "./scripts/buildSql.sh",
    "start": "BROWSER=none next start -p 40000",
    "test": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "node --env-file-if-exists=.env ./node_modules/@playwright/test/cli.js test",
    "test:e2e:headed": "node --env-file-if-exists=.env ./node_modules/@playwright/test/cli.js test --headed",
    "test:watch": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs",
    "test:ui": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs --ui",
    "tsc": "node node_modules/@typescript/native/bin/tsc",
    "coverage": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --coverage",
    "knip": "knip",
    "writeCert": "node --env-file-if-exists=.env --import tsx ./scripts/writeDbCert.ts"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "4.30.0",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-core": "^0.13.11",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.103.3",
    "@tanstack/react-query-devtools": "^5.103.3",
    "@trpc/client": "11.19.0",
    "@trpc/next": "11.19.0",
    "@trpc/react-query": "11.19.0",
    "@trpc/server": "11.19.0",
    "@vercel/node": "^16.0.1",
    "chalk": "^6.0.0",
    "clsx": "^2.1.1",
    "common-tags": "^1.8.2",
    "convert-units": "3.0.0-beta.7",
    "debug": "^4.4.3",
    "dequal": "^2.0.3",
    "fraction.js": "^5.3.4",
    "gray-matter": "^4.0.3",
    "hex-rgb": "^5.0.0",
    "isomorphic-fetch": "^3.0.0",
    "jose": "^6.2.12",
    "jotai": "^3.0.0",
    "listr2": "^11.1.0",
    "luxon": "^3.7.2",
    "next": "^16.3.6",
    "notistack": "^3.0.2",
    "pg": "^8.23.0",
    "query-string": "^9.5.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-json-view": "^1.21.3",
    "react-spinners": "^0.17.1",
    "stringify-object": "^7.0.0",
    "superjson": "^2.2.6",
    "tempy": "^3.2.0",
    "ts-toolbelt": "^9.6.0",
    "tsx": "^4.23.15",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@serwist/turbopack": "^9.5.12",
    "@types/common-tags": "^1.8.4",
    "@types/debug": "~4.1.13",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/jsdom": "~30.0.0",
    "@types/lint-staged": "~14.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stringify-object": "^4.0.5",
    "@types/webpack-env": "^1.18.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "esbuild": "^0.28.2",
    "eslint-plugin-risxss": "^2.1.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knex": "^3.3.0",
    "knex-migrate": "^1.7.4",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "node-fetch": "^3.3.2",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "postinstall-postinstall": "^2.1.0",
    "prisma": "^7.10.0",
    "serwist": "^9.5.12",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "zx": "^8.8.5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "./scripts/noForbiddenCode.sh",
      "oxfmt",
      "oxlint"
    ],
    "*.{css,scss,json,graphql}": [
      "oxfmt"
    ]
  },
  "browserslist": [
    ">0.5%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.20.0"
}
