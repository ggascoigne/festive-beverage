{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "react", "jsx-a11y"],
  "jsPlugins": ["eslint-plugin-risxss"],
  "categories": { "correctness": "off" },
  "options": { "typeAware": true },
  "env": { "builtin": true },
  "ignorePatterns": [
    ".next",
    ".vercel",
    "src/generated",
    "next-env.d.ts",
    "playwright-report",
    "test-results",
    "coverage"
  ],
  "rules": {
    "no-async-promise-executor": "error",
    "no-case-declarations": "error",
    "no-constant-binary-expression": "error",
    "no-debugger": "error",
    "no-duplicate-case": "warn",
    "no-empty": "error",
    "no-fallthrough": "warn",
    "no-loss-of-precision": "error",
    "no-misleading-character-class": "error",
    "no-prototype-builtins": "error",
    "no-unsafe-finally": "error",
    "no-unsafe-optional-chaining": "error",
    "no-useless-assignment": "error",
    "no-useless-catch": "error",
    "no-unused-vars": ["warn", { "args": "none", "ignoreRestSiblings": true }],
    "array-callback-return": ["error", { "allowImplicit": true, "allowVoid": false, "checkForEach": false }],
    "default-case-last": "error",
    "no-await-in-loop": "error",
    "no-console": "off",
    "no-empty-function": "off",
    "no-param-reassign": "off",
    "no-plusplus": "off",
    "no-promise-executor-return": "error",
    "no-use-before-define": ["warn", { "classes": false, "functions": false, "variables": false }],
    "prefer-const": ["warn", { "destructuring": "any", "ignoreReadBeforeAssign": true }],
    "react/no-danger": "warn",
    "react/jsx-key": [
      "warn",
      { "checkFragmentShorthand": true, "checkKeyMustBeforeSpread": false, "warnOnDuplicates": false }
    ],
    "react/jsx-no-comment-textnodes": "warn",
    "react/jsx-no-duplicate-props": "warn",
    "react/jsx-no-target-blank": "warn",
    "react/jsx-pascal-case": ["warn", { "allowAllCaps": true, "ignore": [] }],
    "react/no-danger-with-children": "warn",
    "react/no-direct-mutation-state": "warn",
    "react/no-is-mounted": "warn",
    "react/style-prop-object": "warn",
    "react/exhaustive-deps": "warn",
    "react/rules-of-hooks": "error",
    "risxss/catch-potential-xss-react": "error",
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/anchor-has-content": "warn",
    "jsx-a11y/anchor-is-valid": ["warn", { "aspects": ["noHref", "invalidHref"] }],
    "jsx-a11y/aria-props": "warn",
    "jsx-a11y/aria-proptypes": "warn",
    "jsx-a11y/aria-role": ["warn", { "ignoreNonDOM": true }],
    "jsx-a11y/iframe-has-title": "warn",
    "jsx-a11y/img-redundant-alt": "warn",
    "jsx-a11y/no-access-key": "warn",
    "jsx-a11y/no-redundant-roles": "warn",
    "jsx-a11y/role-has-required-aria-props": "warn",
    "jsx-a11y/role-supports-aria-props": "warn",
    "import/export": "off",
    "import/first": "error",
    "import/newline-after-import": "error",
    "import/no-absolute-path": "error",
    "import/no-amd": "error",
    "import/no-duplicates": "error",
    "import/no-dynamic-require": "error",
    "import/no-mutable-exports": "error",
    "import/no-named-default": "error",
    "import/no-self-import": "error",
    "import/no-webpack-loader-syntax": "error",
    "import/no-anonymous-default-export": [
      "warn",
      {
        "allowAnonymousClass": false,
        "allowAnonymousFunction": false,
        "allowArray": true,
        "allowArrowFunction": false,
        "allowLiteral": false,
        "allowObject": true
      }
    ],
    "typescript/consistent-return": "error",
    "typescript/dot-notation": ["warn", { "allowKeywords": true, "allowPattern": "" }]
  },
  "overrides": [
    {
      "files": ["**/*.{js,mjs,cjs,jsx,mjsx,ts,tsx,mts,cts,mtsx}"],
      "rules": {
        "react/jsx-no-undef": "error",
        "react/no-children-prop": "error",
        "react/no-find-dom-node": "error",
        "react/no-render-return-value": "error",
        "react/no-string-refs": "error",
        "react/no-unescaped-entities": "error",
        "react/no-unknown-property": "error",
        "react/no-unsafe": "off",
        "react/react-in-jsx-scope": "off",
        "react/require-render-return": "error"
      },
      "env": { "browser": true, "serviceworker": true }
    },
    {
      "files": ["**/*.{ts,tsx,mts,cts,mtsx}"],
      "rules": {
        "typescript/ban-ts-comment": "off",
        "typescript/no-empty-object-type": "error",
        "typescript/no-explicit-any": "off",
        "typescript/no-extra-non-null-assertion": "error",
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-wrapper-object-types": "error",
        "typescript/prefer-as-const": "error",
        "typescript/consistent-type-imports": "error"
      }
    },
    { "files": ["support/**/*.js"], "rules": { "func-names": "off" } }
  ]
}
